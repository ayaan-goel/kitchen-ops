    "test": "vitest run",
    "test:tz": "node scripts/test-tz.mjs"
  },
  "dependencies": {
    "luxon": "3.7.2"
  },
  "devDependencies": {
    "@types/luxon": "^3.7.1",
    "typescript": "6.0.3",
    "vitest": "4.1.11"
  }
}
