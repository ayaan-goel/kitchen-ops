{
  "name": "@fernleaf/domain",
  "version": "0.1.0",
  "private": true,
  "description": "Pure business rules: money, pricing, menu, combinations, calendar/cut-off, schedule, billing",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": ["dist"],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsc -p tsconfig.build.json --watch --preserveWatchOutput",
