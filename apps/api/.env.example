# Copy to apps/api/.env and fill in. Never commit the real file.
NODE_ENV=development
PORT=4000

# Neon Postgres (the same database is used for local development and the deployed app).
# DATABASE_URL = pooled connection (host contains "-pooler"); DIRECT_URL = direct connection (migrations).
DATABASE_URL="postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/neondb?sslmode=require"
DIRECT_URL="postgresql://USER:PASSWORD@HOST.REGION.aws.neon.tech/neondb?sslmode=require"

# At least 32 random characters
JWT_SECRET="change-me-to-a-long-random-string-of-32-plus-chars"
SESSION_TTL_HOURS=12

# Kitchen time zone (fixed per deployment, see docs/TRD.md §4.2)
KITCHEN_TZ=Asia/Kolkata

# true in production (HTTPS); false for http://localhost
COOKIE_SECURE=false

DEMO_DATA_ENABLED=true
LOG_LEVEL=debug
